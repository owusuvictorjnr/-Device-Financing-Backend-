PORT=3000
API_HOST_PORT=3001

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=device_financing

DATABASE_URL="postgresql://postgres:change_me@postgres:5432/device_financing?schema=public"
REDIS_HOST=redis
REDIS_PORT=6379

RATE_LIMIT_TTL_MS=60000
